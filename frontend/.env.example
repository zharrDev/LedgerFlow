# ============================================================================
# LEDGERFLOW - Frontend environment variables
# Copy this file to `.env` and fill in real values before running `npm run dev`.
# ============================================================================

# Base URL of the backend API (local dev or deployed on Render).
# Local:  http://localhost:3000
# Deploy: https://ledgerflow-backend-02vs.onrender.com
VITE_API_URL=http://localhost:3000

# Supabase project URL (from Supabase dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anon/public key (safe to expose; RLS protects the data).
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# (Optional) Google OAuth client ID if Google Sign-In is enabled.
# VITE_GOOGLE_CLIENT_ID=YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com
