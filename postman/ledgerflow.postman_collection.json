            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users-management/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users-management", ":id"],
              "variable": [
                { "key": "id", "value": "{{userId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Upload",
      "description": "Upload file ke Supabase Storage (bucket `avatars` & `payment-proofs`, public).",
      "item": [
        {
          "name": "Upload Avatar (Auth)",
          "description": "Body: `{ \"dataUrl\": \"data:image/jpeg;base64,...\" }`. Mengembalikan `{ url }` dan menyimpan URL ke profil user.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/upload/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload", "avatar"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataUrl\": \"data:image/jpeg;base64,<base64-encoded-image>\"\n}"
            }
          }
        },
        {
          "name": "Upload Payment Proof (Auth)",
          "description": "Body: `{ \"dataUrl\": \"...\", \"order_id\": \"optional\" }`. Upload ke folder `orders/{order_id}` atau `users/{userId}`.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/upload/proof",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload", "proof"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataUrl\": \"data:image/png;base64,<base64-encoded-image>\",\n  \"order_id\": \"LF-xxxx\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Payments (Midtrans)",
      "item": [
        {
          "name": "Get Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "plans"]
            }
          }
        },
        {
          "name": "Is Sandbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/is-sandbox",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "is-sandbox"]
            }
          }
        },
        {
          "name": "Get Subscription (Auth)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-user-id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/subscription",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "subscription"]
            }
          }
        },
        {
          "name": "Subscribe (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/subscribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "subscribe"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"pro\",\n  \"billing_cycle\": \"monthly\"\n}"
            }
          }
        },
        {
          "name": "Test Complete (sandbox only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/test-complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "test-complete"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"LF-xxxx\"\n}"
            }
          }
        },
        {
          "name": "Midtrans Webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "webhook"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"LF-xxxx\",\n  \"status_code\": \"200\",\n  \"transaction_status\": \"settlement\",\n  \"payment_type\": \"bank_transfer\",\n  \"fraud_status\": \"accept\",\n  \"gross_amount\": \"299000.00\",\n  \"signature_key\": \"<signature-verification>\"\n}"
            }
          }
        },
        {
          "name": "Payment History (Auth)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "history"]
            }
          }
        },
        {
          "name": "Cancel Subscription (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "cancel"]
            }
          }
        },
        {
          "name": "Check Feature Access (Auth)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/check-access?feature=income_statement",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "check-access"],
              "query": [
                { "key": "feature", "value": "income_statement" }
              ]
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}
