              "raw": "{{baseUrl}}/api/wa/register/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wa", "register", "start"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nama User\",\n  \"company_name\": \"PT Contoh Jaya\",\n  \"phone\": \"08123456789\"\n}"
            }
          }
        },
        {
          "name": "WA Register Verify",
          "description": "Verifikasi kode OTP register. Berhasil → JWT + user dikembalikan.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
